{
  "inbounds": [
    {
      "port": 8080,
      "listen": "0.0.0.0",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "70c50e3a-5b87-49dd-bd20-03c7f2735e40",
            "flow": ""
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/cdnshop"
        }
      }
    },
    // 👇 این inbound جدید اضافه کن
    {
      "port": 80,
      "listen": "0.0.0.0",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "tag": "api",
      "streamSettings": {
        "network": "tcp"
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom"
    }
  ],
  // 👇 این routing اضافه کن
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      }
    ]
  },
  // 👇 این outbound جدید اضافه کن
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "http",
      "tag": "api",
      "settings": {
        "response": {
          "version": "1.1",
          "status": "200",
          "reason": "OK",
          "headers": {
            "Content-Type": "text/html; charset=utf-8"
          },
          "body": "<h1>✅ Xray Server Running</h1><p>Status: Online</p><p>Port: 443</p><p>Path: /cdnshop</p>"
        }
      }
    }
  ]
}
